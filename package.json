{
  "name": "@herdeiroeth/neighbourhood",
  "version": "0.1.0",
  "description": "Command-line file transfer over trusted local networks with resumable downloads.",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "bin": {
    "neighbourhood-client": "./bin/client.js",
    "neighbourhood-server": "./bin/server.js"
  },
  "scripts": {
    "check": "node ./scripts/check.mjs",
    "client": "node ./bin/client.js",
    "server": "node ./bin/server.js",
    "test": "node --test --test-reporter=spec",
    "test:coverage": "node --experimental-test-coverage --test",
    "prepack": "npm run check && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/herdeiroeth/neighbourhood.git"
  },
  "bugs": {
    "url": "https://github.com/herdeiroeth/neighbourhood/issues"
  },
  "homepage": "https://github.com/herdeiroeth/neighbourhood#readme",
  "keywords": [
    "cli",
    "file-sharing",
    "file-transfer",
    "lan",
    "local-network",
    "nodejs",
    "resumable-downloads"
  ],
  "author": {
    "name": "Ryan Trunquim",
    "url": "https://github.com/herdeiroeth"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin/",
    "lib/"
  ],
  "publishConfig": {
    "access": "public"
  }
}
